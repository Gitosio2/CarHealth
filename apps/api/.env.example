# Copy to .env and adjust. Every variable is validated at boot by src/config/env.ts.

# Required. No default: a connection string that silently falls back to
# localhost is how a deployment writes to the wrong database without saying so.
DATABASE_URL=postgres://carhealth:carhealth@localhost:5432/carhealth

# Optional. Shown with their defaults.
PORT=3000
NODE_ENV=development
