# Normalize line endings to LF in the repository and the working tree.
# Overrides each machine's core.autocrlf so checkouts are identical on
# Windows, macOS and Linux, and formatter runs never produce whole-file diffs.
* text=auto eol=lf

# Binary files must never be converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
